# ==========================================================
# SERVER
# ==========================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==========================================================
# DATABASE (MongoDB Atlas or local MongoDB)
# ==========================================================
MONGO_URI=mongodb://127.0.0.1:27017/suryakiran_solar

# ==========================================================
# AUTHENTICATION
# ==========================================================
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ==========================================================
# CLOUDINARY (image / video uploads)
# ==========================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================================
# EMAIL (enquiry / contact-form notifications) — optional
# ==========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL_TO=sksolarsolutions.electrical@gmail.com

# ==========================================================
# WHATSAPP / CALL (used by frontend, mirrored here for SSR/meta needs)
# ==========================================================
COMPANY_PHONE=+91XXXXXXXXXX
COMPANY_WHATSAPP=+91XXXXXXXXXX
