# ==========================================================
# SERVER
# ==========================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==========================================================
# DATABASE (MongoDB Atlas or local MongoDB)
# ==========================================================
MONGO_URI=mongodb://127.0.0.1:27017/suryakiran_solar

# ==========================================================
# AUTHENTICATION
# ==========================================================
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ==========================================================
# CLOUDINARY (image / video uploads)
# ==========================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================================
# EMAIL (enquiry / contact-form notifications) — optional
# ==========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL_TO=info@sksolarsolution.com

# ==========================================================
# WHATSAPP / CALL (used by frontend, mirrored here for SSR/meta needs)
# ==========================================================
COMPANY_PHONE=+91XXXXXXXXXX
COMPANY_WHATSAPP=+91XXXXXXXXXX

# ==========================================================
# SMS LEAD ALERTS (optional — email works without this)
# ----------------------------------------------------------
# IMPORTANT for Indian numbers: TRAI requires DLT registration
# (Principal Entity + Sender ID + approved template) before any
# transactional SMS will be delivered. Unregistered messages are
# silently dropped by carriers. See utils/sendSms.js for details.
# Until DLT is complete, use the WhatsApp link in the lead email.
# ==========================================================
# SMS_PROVIDER=msg91          # msg91 | twilio
# SMS_ALERT_TO=+919XXXXXXXXX  # sales number that receives alerts
# MSG91_AUTHKEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ==========================================================
# EMAIL VIA HTTP API (required in production)
# ----------------------------------------------------------
# Render and most free/shared hosts block outbound SMTP ports
# (25/465/587) to curb spam — Gmail sends fail there with
# "Connection timeout" no matter how correct the credentials.
# An email API talks HTTPS on 443, which is never blocked.
#
# Set ONE of these. When present it takes priority over SMTP;
# leave both unset locally to keep using Gmail SMTP in dev.
# ==========================================================
# BREVO_API_KEY=          # 300 emails/day free — verify the sender address in Brevo
# RESEND_API_KEY=         # 3,000/month free — needs a verified domain
# MAIL_FROM=              # optional; defaults to SMTP_USER
